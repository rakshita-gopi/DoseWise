# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Example: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dosewise?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dosewise?retryWrites=true&w=majority

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin(s) for CORS + Socket.io (comma-separated if multiple)
# Local: http://localhost:5173
# Production: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# OpenRouter AI (required for prescription/bill/chat AI features)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_SITE_URL=http://localhost:5173/
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Persistent file storage (recommended for Render — free tier disk is ephemeral)
# Create a free account at https://cloudinary.com and paste values from the dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dosewise

# Optional integrations
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# LOW_STOCK_DAYS_THRESHOLD=2
